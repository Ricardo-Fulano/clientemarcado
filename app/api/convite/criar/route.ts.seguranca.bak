
import { NextRequest, NextResponse } from 'next/server'
import { createClient } from '@supabase/supabase-js'
import crypto from 'crypto'

// Criacao segura de convites de transferencia.
//
// Fluxo:
// 1. Autentica o proprietario.
// 2. Prepara um convite sem cancelar o anterior.
// 3. Envia o e-mail pelo Resend.
// 4. Registra o resultado do envio.
// 5. Ativa o novo convite de forma transacional.
//
// ATENCAO:
// Depende das RPCs preparar_convite_transferencia,
// ativar_convite_transferencia e
// recuperar_convite_transferencia.
//
// NAO PUBLICAR ANTES DE INSTALAR E VALIDAR AS RPCs
// E IMPLEMENTAR A RECUPERACAO DOS ENVIOS INCERTOS.

function escaparHtml(valor: string): string {
  return valor.replace(/[&<>"']/g, (caractere) => {
    const entidades: Record<string, string> = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }
    return entidades[caractere] || caractere
  })
}

export async function POST(request: NextRequest) {
  try {
    const authHeader = request.headers.get('Authorization')

    if (!authHeader?.startsWith('Bearer ')) {
      return NextResponse.json(
        { error: 'Não autorizado.' },
        { status: 401 }
      )
    }

    const supabase = createClient(
      process.env.NEXT_PUBLIC_SUPABASE_URL!,
      process.env.SUPABASE_SERVICE_ROLE_KEY!
    )

    const tokenAutenticacao = authHeader.slice(7)

    const {
      data: { user: admin },
      error: authError,
    } = await supabase.auth.getUser(tokenAutenticacao)

    if (authError || !admin) {
      return NextResponse.json(
        { error: 'Não autorizado.' },
        { status: 401 }
      )
    }

    const body = await request.json().catch(() => null)

    const emailNovo =
      typeof body?.email_novo === 'string'
        ? body.email_novo.trim().toLowerCase()
        : ''

    if (!emailNovo || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailNovo)) {
      return NextResponse.json(
        { error: 'Informe um e-mail válido.' },
        { status: 400 }
      )
    }

    const { data: perfil, error: erroPerfil } = await supabase
      .from('perfis')
      .select('id, user_id, nome_negocio')
      .eq('user_id', admin.id)
      .single()

    if (erroPerfil || !perfil) {
      return NextResponse.json(
        { error: 'Perfil não encontrado.' },
        { status: 404 }
      )
    }

    if (emailNovo === (admin.email || '').toLowerCase()) {
      return NextResponse.json(
        {
          error:
            'O novo e-mail precisa ser diferente do e-mail atual.',
        },
        { status: 400 }
      )
    }

    const resendKey = process.env.RESEND_API_KEY

    if (!resendKey) {
      console.error(
        '[convite/criar] RESEND_API_KEY não configurada.'
      )

      return NextResponse.json(
        {
          error:
            'Envio de e-mail não configurado. Fale com o suporte.',
        },
        { status: 500 }
      )
    }

    // Gera um token aleatorio.
    // Somente seu hash SHA-256 sera armazenado no banco.
    const tokenCru = crypto.randomBytes(32).toString('base64url')
    const tokenHash = crypto
      .createHash('sha256')
      .update(tokenCru)
      .digest('hex')

    const expiraEm = new Date(
      Date.now() + 7 * 24 * 60 * 60 * 1000
    )

    // PREPARACAO:
    // Nao cancela convites anteriores.
    // A RPC deve confirmar a titularidade dentro
    // da propria transacao PostgreSQL.
    const {
      data: conviteId,
      error: erroPreparacao,
    } = await supabase.rpc('preparar_convite_transferencia', {
      p_perfil_id: perfil.id,
      p_user_id_atual: admin.id,
      p_email_novo: emailNovo,
      p_token_hash: tokenHash,
      p_expira_em: expiraEm.toISOString(),
    })

    if (erroPreparacao || !conviteId) {
      console.error(
        '[convite/criar] Falha na preparação:',
        erroPreparacao?.message
      )

      const conflito =
        erroPreparacao?.message?.includes(
          'CONVITE_EM_PREPARACAO'
        ) ?? false

      return NextResponse.json(
        {
          error: conflito
            ? 'Já existe uma transferência sendo preparada. Aguarde a resolução dessa solicitação.'
            : 'Não foi possível preparar o convite.',
        },
        { status: conflito ? 409 : 500 }
      )
    }

    const siteUrl = (
      process.env.NEXT_PUBLIC_SITE_URL ||
      'https://clientemarcado.com.br'
    ).replace(/\/$/, '')

    const linkConvite = `${siteUrl}/convite/${tokenCru}`

    const nomeNegocio =
      perfil.nome_negocio || 'ClienteMarcado'

    const nomeSeguro = escaparHtml(nomeNegocio)
    const linkSeguro = escaparHtml(linkConvite)

    const emailHtml = `
      <div style="font-family:Arial,sans-serif;max-width:560px;margin:0 auto;padding:32px;color:#181018;">
        <h1 style="font-size:24px;margin-bottom:16px;">
          Você recebeu acesso a uma página profissional
        </h1>

        <p style="font-size:16px;line-height:1.6;color:#3f3540;">
          Você foi convidada(o) a assumir o acesso da página profissional
          <strong>${nomeSeguro}</strong> no ClienteMarcado.
        </p>

        <p style="font-size:16px;line-height:1.6;color:#3f3540;">
          Clique no botão abaixo para aceitar o convite e criar sua própria senha de acesso.
        </p>

        <p style="margin:28px 0;">
          <a href="${linkSeguro}"
             style="display:inline-block;background:#EC4899;color:#ffffff;text-decoration:none;font-weight:700;padding:14px 22px;border-radius:12px;">
            Aceitar convite e criar senha
          </a>
        </p>

        <p style="font-size:13px;color:#6b5f6b;">
          Este link expira em 7 dias e só pode ser usado uma vez.
          Se você não esperava este convite, pode ignorar este e-mail.
        </p>

        <hr style="border:0;border-top:1px solid #eee2ee;margin:28px 0;" />

        <p style="font-size:13px;color:#8a7c8a;">
          ClienteMarcado<br/>
          Página profissional, agenda online e gestão para beleza e estética.
        </p>
      </div>
    `

    let respostaResend: Response

    try {
      respostaResend = await fetch(
        'https://api.resend.com/emails',
        {
          method: 'POST',
          headers: {
            Authorization: `Bearer ${resendKey}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            from: 'ClienteMarcado <noreply@clientemarcado.com.br>',
            to: [emailNovo],
            subject:
              `Você recebeu acesso à página profissional ${nomeNegocio}`,
            html: emailHtml,
          }),
          signal: AbortSignal.timeout(15000),
        }
      )
    } catch (erroEnvio) {
      // Falha de rede nao comprova que o Resend
      // rejeitou o e-mail.
      // Mantemos a preparacao para reconciliacao.
      console.error(
        '[convite/criar] Resultado do envio desconhecido:',
        erroEnvio
      )

      return NextResponse.json(
        {
          error:
            'Não foi possível confirmar o envio. A transferência precisa ser verificada antes de uma nova tentativa.',
          codigo: 'ENVIO_INDETERMINADO',
        },
        { status: 503 }
      )
    }

    if (!respostaResend.ok) {
      const detalhes = await respostaResend
        .text()
        .catch(() => '')

      console.error(
        '[convite/criar] Resend rejeitou o envio:',
        respostaResend.status,
        detalhes
      )

      const { error: erroRegistro } = await supabase
        .from('convites_transferencia')
        .update({
          email_status: 'falhou',
          email_erro:
            `Resend rejeitou o envio (HTTP ${respostaResend.status})`,
        })
        .eq('id', conviteId)
        .eq('status', 'preparando')

      if (erroRegistro) {
        console.error(
          '[convite/criar] Erro ao registrar rejeição:',
          erroRegistro.message
        )
      } else {
        const { error: erroRecuperacao } = await supabase.rpc(
          'recuperar_convite_transferencia',
          { p_convite_id: conviteId }
        )

        if (erroRecuperacao) {
          console.error(
            '[convite/criar] Erro na recuperação:',
            erroRecuperacao.message
          )
        }
      }

      return NextResponse.json(
        {
          error:
            'Não foi possível enviar o convite. O convite anterior não foi cancelado.',
          codigo: 'ENVIO_REJEITADO',
        },
        { status: 502 }
      )
    }

    const dadosResend = (await respostaResend
      .json()
      .catch(() => null)) as { id?: string } | null

    const resendId = dadosResend?.id

    if (!resendId || typeof resendId !== 'string') {
      console.error(
        '[convite/criar] Resend aceitou a requisição sem ID utilizável.'
      )

      return NextResponse.json(
        {
          error:
            'O envio foi aceito, mas não foi possível confirmar seu identificador. A transferência precisa de reconciliação.',
          codigo: 'ENVIO_SEM_IDENTIFICADOR',
        },
        { status: 503 }
      )
    }

    // Registra que a API do Resend aceitou o envio.
    // Isto nao significa que o e-mail foi entregue.
    const { error: erroRegistro } = await supabase
      .from('convites_transferencia')
      .update({
        resend_email_id: resendId,
        email_status: 'enviado',
        email_enviado_em: new Date().toISOString(),
        email_erro: null,
      })
      .eq('id', conviteId)
      .eq('status', 'preparando')

    if (erroRegistro) {
      console.error(
        '[convite/criar] Falha ao registrar envio:',
        erroRegistro.message
      )

      return NextResponse.json(
        {
          error:
            'O e-mail foi aceito pelo provedor, mas a transferência ainda precisa ser confirmada.',
          codigo: 'REGISTRO_PENDENTE',
        },
        { status: 503 }
      )
    }

    // ATIVACAO:
    // Somente agora solicita o cancelamento atomico
    // dos convites anteriores.
    const { data: ativado, error: erroAtivacao } =
      await supabase.rpc('ativar_convite_transferencia', {
        p_convite_id: conviteId,
      })

    if (erroAtivacao || ativado !== true) {
      console.error(
        '[convite/criar] Falha na ativação:',
        erroAtivacao?.message
      )

      return NextResponse.json(
        {
          error:
            'O e-mail foi aceito pelo provedor, mas a ativação do convite ainda está pendente.',
          codigo: 'ATIVACAO_PENDENTE',
        },
        { status: 503 }
      )
    }

    return NextResponse.json({
      ok: true,
      mensagem: 'Convite preparado, enviado e ativado.',
    })
  } catch (erro) {
    console.error('[convite/criar] Erro interno:', erro)

    return NextResponse.json(
      { error: 'Erro interno ao criar o convite.' },
      { status: 500 }
    )
  }
}
